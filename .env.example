# 이 파일을 복사해서 같은 폴더에 .env 파일을 만들고 값을 채워 주세요.
#   Copy-Item .env.example .env
# ⚠ .env 에는 개인 API 키가 들어가므로 절대 GitLab 에 올리지 마세요.

# SSAFY GMS 에서 발급받은 API 키
GMS_KEY=여기에_GMS_KEY_입력

# GMS 에서 사용할 모델 (GMS 콘솔에서 사용 가능한 모델명 확인)
GMS_MODEL=gpt-4o-mini

# GMS OpenAI 호환 엔드포인트 (보통 수정할 필요 없음)
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# False 로 바꾸면 크롬 창이 직접 뜨면서 크롤링 과정을 볼 수 있음 (시연/캡처용)
CRAWLER_HEADLESS=True

# 수집할 커뮤니티 댓글 수
CRAWLER_COMMENT_LIMIT=20
